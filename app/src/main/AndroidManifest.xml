<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Required by BiometricPrompt / BiometricManager (fingerprint, face, phone PIN unlock). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Read bank transaction SMS when the user asks to scan (Settings / Dashboard > Import from SMS). -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Live capture: notice bank SMS as they arrive (only when switched on in Settings). -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- The "bank payments" notification (Android 13+ asks the user). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- READ_SMS implies telephony; keep the app installable on devices without it. -->
    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/app_name"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Only the system may deliver SMS broadcasts (BROADCAST_SMS is a system permission). -->
        <receiver
            android:name=".data.sms.BankSmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
